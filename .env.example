# Supabase (Project Settings -> API / Connect)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public URL of the site (used for metadata / OG links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI coach (server-only; never prefix with NEXT_PUBLIC_)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier Flash models. Fallback is used when the main model is busy (503/429).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
